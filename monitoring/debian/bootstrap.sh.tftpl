#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl gnupg lsb-release awscli
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable docker
systemctl start docker

mkdir -p /opt/monitoring/grafana-data
mkdir -p /opt/monitoring/provisioning/datasources

cat > /opt/monitoring/docker-compose.yml <<'EOF_COMPOSE'
services:
  grafana:
    image: grafana/grafana:11.1.4
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=${grafana_admin_user}
      - GF_SECURITY_ADMIN_PASSWORD=${grafana_admin_password}
    volumes:
      - /opt/monitoring/grafana-data:/var/lib/grafana
      - /opt/monitoring/provisioning:/etc/grafana/provisioning
EOF_COMPOSE

if [ -n "${prometheus_url}" ]; then
  cat > /opt/monitoring/provisioning/datasources/datasource.yml <<EOF_DS
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: ${prometheus_url}
    isDefault: true
EOF_DS
fi

docker compose -f /opt/monitoring/docker-compose.yml up -d

if [ -n "${backup_s3_bucket}" ]; then
  cat > /usr/local/bin/backup-grafana-s3.sh <<'EOF_BACKUP'
#!/bin/bash
set -euo pipefail
ts=$(date -u +"%Y%m%dT%H%M%SZ")
backup_file="/tmp/grafana-backup-${ts}.tar.gz"
tar -czf "${backup_file}" -C /opt/monitoring grafana-data
aws s3 cp "${backup_file}" "s3://${backup_s3_bucket}/grafana/${HOSTNAME}/grafana-backup-${ts}.tar.gz" --region ${aws_region}
rm -f "${backup_file}"
EOF_BACKUP
  chmod +x /usr/local/bin/backup-grafana-s3.sh
  echo "${backup_cron} root /usr/local/bin/backup-grafana-s3.sh >> /var/log/grafana-backup.log 2>&1" > /etc/cron.d/grafana-backup
  chmod 0644 /etc/cron.d/grafana-backup
  systemctl restart cron || true
fi
